generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ESTUDIANTE
  DOCENTE
  ADMIN
}

enum TipoRecurso {
  VIDEO
  AUDIO
  DOCUMENTO
  SIMULADOR
  IMAGEN
}

enum EstadoCaso {
  ACTIVO
  EN_CURADURIA
  BORRADOR
}

enum Epoca {
  ANTES_1997
  ENTRE_1997_2000
  RETORNO
}

enum PiezaJardin {
  FLOR
  HOJA
  SEMILLA
  MANO
}

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

enum Subsidio {
  NINGUNO
  RIEGO
  AGRICULTURA
}

model User {
  id           String   @id @default(cuid())
  usuario      String   @unique
  email        String   @unique
  passwordHash String
  nombre       String
  iniciales    String
  rol          Rol
  subpoblacion String?
  creadoEn     DateTime @default(now())

  /// Las cuentas nacen con una contraseña provisional que entrega quien las
  /// crea. Mientras la marca siga activa, la plataforma solo deja pasar a la
  /// pantalla de cambio de contraseña.
  debeCambiarContrasena Boolean   @default(true)
  contrasenaCambiadaEn  DateTime?

  /// Quién dio de alta a este usuario: el administrador crea docentes y el
  /// docente crea a sus estudiantes.
  creadoPorId String?
  creadoPor   User?   @relation("UsuariosCreados", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creados     User[]  @relation("UsuariosCreados")

  anotaciones     Anotacion[]
  marcas          MarcaCartografia[]
  simulaciones    Simulacion[]
  floresJardin    FlorJardin[]
  entradasDiario  EntradaDiario[]
  respuestas      RespuestaActividad[]
  recursosSubidos Recurso[]
  forosCreados    Foro[]
  mensajesForo    MensajeForo[]
  posturasForo    ParticipanteForo[]

  /// Acompañamiento: lo que pidió como estudiante y lo que recibió como docente.
  solicitudesHechas    SolicitudAcompanamiento[] @relation("SolicitudDeEstudiante")
  solicitudesRecibidas SolicitudAcompanamiento[] @relation("SolicitudParaDocente")

  /// El estudiante pertenece a lo sumo a un curso de su docente, y dentro de
  /// él a un grupo de trabajo. Sin curso, sigue siendo del docente que lo creó.
  cursoId String?
  curso   Curso?  @relation("EstudiantesDelCurso", fields: [cursoId], references: [id], onDelete: SetNull)
  grupoId String?
  grupo   Grupo?  @relation("MiembrosDelGrupo", fields: [grupoId], references: [id], onDelete: SetNull)

  /// Los cursos que dicta, si es docente.
  cursosDictados Curso[] @relation("CursosDelDocente")
}

/// Un curso de un docente, con su año lectivo. Organiza a sus estudiantes: el
/// panel y los reportes se pueden mirar curso por curso.
model Curso {
  id       String   @id @default(cuid())
  nombre   String
  anio     Int
  creadoEn DateTime @default(now())

  docenteId String
  docente   User   @relation("CursosDelDocente", fields: [docenteId], references: [id], onDelete: Cascade)

  estudiantes User[]  @relation("EstudiantesDelCurso")
  grupos      Grupo[]
  foros       Foro[]

  @@unique([docenteId, nombre, anio])
}

/// Grupo de trabajo dentro de un curso, para las actividades colectivas que
/// pide la guía, como elegir juntos el lugar significativo de la cartografía.
model Grupo {
  id       String   @id @default(cuid())
  nombre   String
  creadoEn DateTime @default(now())

  cursoId String
  curso   Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  miembros User[]             @relation("MiembrosDelGrupo")
  marcas   MarcaCartografia[]

  @@unique([cursoId, nombre])
}

model Caso {
  id       String     @id @default(cuid())
  nombre   String     @unique
  depto    String     @db.Text
  estado   EstadoCaso @default(EN_CURADURIA)
  version  String     @default("0.1.0")
  activo   Boolean    @default(false)
  /// Ubicación del caso de estudio en el mapa de Colombia.
  lat      Float?
  lon      Float?
  creadoEn DateTime   @default(now())

  ejes       Eje[]
  documentos DocumentoFuente[]
}

model Eje {
  id              String  @id @default(cuid())
  numero          Int
  nombre          String
  descripcion     String  @db.Text
  objetivoGeneral String? @db.Text
  tono            String
  orden           Int
  // El Preámbulo "Me cuido y nos cuidamos" antecede a los ejes numerados.
  esPreambulo     Boolean @default(false)

  /// Cuánto pesa este eje en el avance del curso, de los 100 puntos que el
  /// docente reparte entre todos. Dentro del eje, sus sesiones publicadas se
  /// reparten ese peso a partes iguales.
  peso Int @default(0)

  casoId String
  caso   Caso   @relation(fields: [casoId], references: [id], onDelete: Cascade)

  sesiones Sesion[]
  recursos Recurso[]

  @@unique([casoId, numero])
}

model Sesion {
  id            String  @id @default(cuid())
  codigo        String
  titulo        String  @db.Text
  objetivo      String? @db.Text
  tipo          String
  pantalla      String
  publicada     Boolean @default(false)
  alertaCuidado Boolean @default(false)
  /// Lo que lee el estudiante antes del contenido cuando la alerta está activa.
  textoAlerta   String? @db.Text
  orden         Int

  /// Texto de la sesión tal como venía en el documento importado. Es lo que
  /// lee el estudiante al abrir la actividad: sin esto la pantalla no tendría
  /// nada propio que mostrar.
  contenido           String? @db.Text
  /// Pregunta que encabeza la actividad. Se toma del documento cuando aparece.
  preguntaOrientadora String? @db.Text

  ejeId String
  eje   Eje    @relation(fields: [ejeId], references: [id], onDelete: Cascade)

  subsecciones Subseccion[]

  /// Trabajo que los estudiantes producen dentro de esta sesión.
  anotaciones    Anotacion[]
  marcas         MarcaCartografia[]
  flores         FlorJardin[]
  entradasDiario EntradaDiario[]
  respuestas     RespuestaActividad[]
  simulaciones   Simulacion[]

  /// Debates que el docente asoció a esta sesión, como el de la 1.3.
  foros Foro[]

  /// Material multimedia propio de esta sesión.
  recursos Recurso[]

  /// Solicitudes de acompañamiento hechas desde esta sesión.
  solicitudes SolicitudAcompanamiento[]

  @@unique([ejeId, codigo])
}

/// Tercer nivel de la guía del CNMH: 1.2 → 1.2.1, 1.2.2 …
model Subseccion {
  id     String @id @default(cuid())
  codigo String
  titulo String @db.Text
  orden  Int

  /// Texto de la subsección en el documento de origen.
  contenido String? @db.Text

  sesionId String
  sesion   Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@unique([sesionId, codigo])
}

/// Documento del que se derivó un módulo (guía o informe del CNMH).
model DocumentoFuente {
  id            String   @id @default(cuid())
  titulo        String   @db.Text
  nombreArchivo String   @db.Text
  rutaArchivo   String   @db.Text
  paginas       Int
  subidoEn      DateTime @default(now())

  /// Las guías para maestros traen las respuestas esperadas y las
  /// orientaciones para conducir la sesión. Ponerlas al alcance del estudiante
  /// arruinaría la actividad, así que se pueden reservar al docente.
  soloDocentes Boolean @default(false)

  casoId String?
  caso   Caso?   @relation(fields: [casoId], references: [id], onDelete: SetNull)
}

model Recurso {
  id       String      @id @default(cuid())
  titulo   String      @db.Text
  contexto String      @db.Text
  tipo     TipoRecurso
  alerta   Boolean     @default(false)
  creadoEn DateTime    @default(now())

  ejeId String
  eje   Eje    @relation(fields: [ejeId], references: [id], onDelete: Cascade)

  /// Sesión concreta en que se usa. Vacía: el recurso es de todo el eje.
  sesionId String?
  sesion   Sesion? @relation(fields: [sesionId], references: [id], onDelete: SetNull)

  /// El recurso en sí: un archivo del depósito o un enlace externo, nunca los dos.
  /// `archivo` es la ruta dentro del depósito, p. ej. `recursos/<id>.mp3`.
  archivo String?
  mime    String?
  tamano  Int?
  /// Video alojado fuera, p. ej. en YouTube: los largos no caben en el depósito.
  enlace  String? @db.Text

  /// Transcripción del audio o del video: WebVTT si trae tiempos, texto si no.
  /// Sin la que le corresponde, el estudiante no ve el recurso (CU10).
  transcripcion String? @db.Text

  autorId String?
  autor   User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)

  auditoria AuditoriaAccesibilidad?
}

model AuditoriaAccesibilidad {
  id            String   @id @default(cuid())
  descripcion   String   @db.Text
  transcripcion Boolean  @default(false)
  contraste     Boolean  @default(false)
  responsivo    Boolean  @default(false)
  revisadaEn    DateTime @default(now())

  recursoId String  @unique
  recurso   Recurso @relation(fields: [recursoId], references: [id], onDelete: Cascade)
}

model Anotacion {
  id       String   @id @default(cuid())
  texto    String   @db.Text
  cita     String?  @db.Text
  creadoEn DateTime @default(now())

  autorId String
  autor   User   @relation(fields: [autorId], references: [id], onDelete: Cascade)

  sesionId String
  sesion   Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId])
}

model MarcaCartografia {
  id            String   @id @default(cuid())
  lugar         String   @db.Text
  relato        String   @db.Text
  /// Texto que mostraba la v1 en lugar del audio. Se mantiene al día para que
  /// la versión publicada siga leyendo algo con sentido.
  audio         String   @default("Sin audio")
  /// El relato grabado en el navegador: ruta en el depósito, tipo y duración.
  audioArchivo  String?
  audioMime     String?
  audioSegundos Int?
  /// Foto del lugar, ya reducida en el navegador. Ruta en el depósito.
  foto          String?
  /// Sensaciones que el estudiante asocia al lugar que marcó.
  tags          String[]
  /// Coordenadas geográficas reales del punto marcado en el mapa.
  lat           Float
  lon           Float
  creadoEn      DateTime @default(now())

  autorId String
  autor   User   @relation(fields: [autorId], references: [id], onDelete: Cascade)

  sesionId String
  sesion   Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  /// Si el lugar lo eligió el grupo de trabajo del autor, como pide la guía.
  /// Cuenta para todos sus miembros.
  grupoId String?
  grupo   Grupo?  @relation(fields: [grupoId], references: [id], onDelete: SetNull)

  @@index([sesionId])
}

model Simulacion {
  id            String    @id @default(cuid())
  indiceEquidad Int       @default(0)
  validadaEn    DateTime?
  actualizadoEn DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sesionId String
  sesion   Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  asignaciones Asignacion[]

  /// Cada estudiante tiene una simulación por sesión, no una sola en total.
  @@unique([userId, sesionId])
}

model Familia {
  id          String    @id @default(cuid())
  nombre      String    @db.Text
  personas    Int
  menores     Int
  cabezaMujer Boolean
  etnica      Boolean
  retornada   Boolean
  prioridad   Prioridad
  orden       Int       @unique

  asignaciones Asignacion[]
}

model Asignacion {
  id        String   @id @default(cuid())
  hectareas Int      @default(0)
  subsidio  Subsidio @default(NINGUNO)

  simulacionId String
  simulacion   Simulacion @relation(fields: [simulacionId], references: [id], onDelete: Cascade)
  familiaId    String
  familia      Familia    @relation(fields: [familiaId], references: [id], onDelete: Cascade)

  @@unique([simulacionId, familiaId])
}

model FlorJardin {
  id       String      @id @default(cuid())
  nombre   String      @db.Text
  legado   String      @db.Text
  epoca    Epoca
  pieza    PiezaJardin
  tono     String
  altura   Int
  creadoEn DateTime    @default(now())

  /// La creación que acompaña a la flor (CU04): una carta, un poema, un
  /// dibujo hecho en la plataforma o la foto de uno hecho en papel.
  creacion    Creacion @default(NINGUNA)
  /// Texto de la carta o del poema, con sus saltos de línea.
  texto       String?  @db.Text
  /// Dibujo o foto: ruta en el depósito.
  imagen      String?
  /// Qué muestra la imagen, para quien no puede verla. Opcional.
  descripcion String?

  autorId String?
  autor   User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)

  sesionId String
  sesion   Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@index([sesionId])
}

enum Creacion {
  NINGUNA
  CARTA
  POEMA
  DIBUJO
  FOTO
}

model EntradaDiario {
  id       String   @id @default(cuid())
  emocion  String
  texto    String   @db.Text
  privada  Boolean  @default(true)
  creadoEn DateTime @default(now())

  autorId String
  autor   User   @relation(fields: [autorId], references: [id], onDelete: Cascade)

  /// El diario también se puede escribir fuera de una sesión concreta, desde
  /// el espacio personal del estudiante.
  sesionId String?
  sesion   Sesion? @relation(fields: [sesionId], references: [id], onDelete: SetNull)

  @@index([sesionId])
}

model Foro {
  id       String   @id @default(cuid())
  pregunta String   @db.Text
  rolA     String   @db.Text
  rolB     String   @db.Text
  fuentes  String   @default("Por asignar")
  abierto  Boolean  @default(true)
  creadoEn DateTime @default(now())

  autorId String?
  autor   User?   @relation(fields: [autorId], references: [id], onDelete: SetNull)

  /// Sesión en la que se debate, si el docente la indicó. Opcional: un foro
  /// también puede abrirse suelto.
  sesionId String?
  sesion   Sesion? @relation(fields: [sesionId], references: [id], onDelete: SetNull)

  /// Curso al que se abre. Sin curso, lo ven todos los estudiantes del docente.
  cursoId String?
  curso   Curso?  @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  participantes ParticipanteForo[]
  mensajes      MensajeForo[]
}

/// Los dos bandos del debate. La mediación del docente no toma partido.
enum Postura {
  A
  B
}

/// Rol que asume cada estudiante en un foro. El docente lo asigna; si alguien
/// entra sin rol, se le da el del bando con menos gente.
model ParticipanteForo {
  id      String  @id @default(cuid())
  postura Postura

  foroId String
  foro   Foro   @relation(fields: [foroId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([foroId, userId])
}

model MensajeForo {
  id        String   @id @default(cuid())
  texto     String   @db.Text
  /// Documento o pasaje en que se apoya el argumento. La guía pide construir
  /// los argumentos sobre fuentes históricas, así que en un argumento es
  /// obligatoria; en una respuesta, no.
  fuente    String?  @db.Text
  /// Bando desde el que se escribe. Vacío en los mensajes del docente.
  postura   Postura?
  destacado Boolean  @default(false)
  creadoEn  DateTime @default(now())

  foroId  String
  foro    Foro   @relation(fields: [foroId], references: [id], onDelete: Cascade)
  autorId String
  autor   User   @relation(fields: [autorId], references: [id], onDelete: Cascade)

  /// Mensaje al que responde. Vacío en un argumento que abre hilo.
  respuestaAId String?
  respuestaA   MensajeForo?  @relation("Respuestas", fields: [respuestaAId], references: [id], onDelete: Cascade)
  respuestas   MensajeForo[] @relation("Respuestas")

  @@index([foroId])
}

/// Respuesta escrita del estudiante a una sesión. Sustituye a la antigua
/// RespuestaCopla, que solo servía para un ejercicio concreto del prototipo.
model RespuestaActividad {
  id            String   @id @default(cuid())
  texto         String   @db.Text
  /// Lo que la actividad pide además del texto, según su tipo: dónde ubicó
  /// cada producto de la copla, qué opción eligió en un dilema...
  datos         Json?
  actualizadoEn DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sesionId String
  sesion   Sesion @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  @@unique([userId, sesionId])
}

model ReporteDiferenciado {
  id       String   @id @default(cuid())
  resumen  String   @db.Text
  creadoEn DateTime @default(now())
}

/// Un estudiante pide hablar con su docente, desde una sesión con alerta de
/// cuidado o desde el botón general. Le llega solo a su docente.
model SolicitudAcompanamiento {
  id         String    @id @default(cuid())
  /// Opcional: no se le exige explicarse a quien pide ayuda.
  mensaje    String?   @db.Text
  creadoEn   DateTime  @default(now())
  atendidaEn DateTime?

  estudianteId String
  estudiante   User    @relation("SolicitudDeEstudiante", fields: [estudianteId], references: [id], onDelete: Cascade)
  docenteId    String
  docente      User    @relation("SolicitudParaDocente", fields: [docenteId], references: [id], onDelete: Cascade)
  sesionId     String?
  sesion       Sesion? @relation(fields: [sesionId], references: [id], onDelete: SetNull)

  @@index([docenteId, atendidaEn])
}
