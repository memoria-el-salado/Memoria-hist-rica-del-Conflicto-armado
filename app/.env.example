# Elige UNA de las dos líneas según el motor que uses.
# Después ejecuta:  npm run db:motor mysql   (o postgresql)

# MySQL 8 / XAMPP (root sin contraseña, que es lo habitual en XAMPP)
DATABASE_URL="mysql://root@localhost:3306/memoria_el_salado"

# PostgreSQL
# DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/memoria_el_salado?schema=public"

AUTH_SECRET="genera-uno-con-npx-auth-secret"
AUTH_TRUST_HOST=true
