# Base de datos PostgreSQL. En Supabase, la cadena del puerto 5432 (conexión de
# sesión) es la que admite `npm run db:sincronizar`; la del 6543 con
# ?pgbouncer=true va en las variables de entorno de Vercel, no aquí.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:5432/postgres"

# Genera el tuyo con:  npx auth secret
AUTH_SECRET="genera-uno-con-npx-auth-secret"
AUTH_TRUST_HOST=true

# Depósito privado de Supabase donde se guardan los PDF que sube el
# administrador. Sin estas tres variables los archivos se escriben en
# app/almacen/, que sirve para ejecutar el proyecto en el propio equipo.
SUPABASE_URL="https://REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="la-llave-service_role"
SUPABASE_BUCKET="documentos"
